# MuseumOS — Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL="postgresql://museumos:museumos@localhost:5432/museumos?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="museumos"
MINIO_SECRET_KEY="museumos-secret"
MINIO_BUCKET="museumos-images"
MINIO_USE_SSL=false

# API
API_PORT=3000
API_URL="http://localhost:3000"

# Web
WEB_PORT=5173
WEB_URL="http://localhost:5173"

# PWA
PWA_PORT=5174

# Session
# REQUIRED in production — the API refuses to boot without it and rejects
# anything under 32 characters. In development an ephemeral secret is
# generated if this is unset (sessions won't survive a restart).
# Generate with: openssl rand -hex 64
SESSION_SECRET=""

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# First-run admin, read by `pnpm db:seed`. If the password is omitted a
# random one is generated and printed once.
SEED_ADMIN_EMAIL="admin@museumos.local"
# SEED_ADMIN_PASSWORD=

# Branding shown in the admin UI's marketing composer (all optional).
VITE_ORG_SHORT_NAME=""
VITE_PUBLIC_SITE_URL=""
VITE_SOCIAL_HANDLE=""
VITE_SOCIAL_HASHTAGS=""

# Contact URL or email sent to Wikidata in the User-Agent (optional).
WIKIDATA_CONTACT=""

# eBay Browse API (optional — only needed for the "Find on eBay" button)
# Register at https://developer.ebay.com/ to get an App ID + Cert ID
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
# EBAY_GB | EBAY_US | EBAY_DE | EBAY_GR | … (see eBay marketplace IDs)
EBAY_MARKETPLACE="EBAY_GB"
# "production" or "sandbox"
EBAY_ENV="production"
