# MuseumOS — production environment variables
#
# Copy to `.env` next to docker-compose.prod.yml, or paste these into your
# platform's environment UI (Coolify, Dokploy, Portainer…). Anything left
# unset falls back to the defaults in docker-compose.prod.yml.

# ─── Database ─────────────────────────────────────────────────
DB_USER=museumos
DB_NAME=museumos
# Generate with: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME

# ─── Sessions ─────────────────────────────────────────────────
# REQUIRED. The API refuses to start in production without this, and rejects
# anything shorter than 32 characters — a weak or default signing secret lets
# anyone mint a valid admin session cookie.
# Generate with: openssl rand -hex 64
SESSION_SECRET=CHANGE_ME

# ─── Hostnames ────────────────────────────────────────────────
# Public hostnames for the admin app and the mobile capture PWA. Used by the
# Traefik router rules and, by default, to derive CORS_ORIGINS.
WEB_HOST=museumos.example.org
PWA_HOST=capture.example.org

# ─── Reverse proxy ────────────────────────────────────────────
# Only needed when routing through an external Traefik. The network must
# already exist and be owned by that proxy; MuseumOS joins it as `external`.
PROXY_NETWORK=proxy-net
PROXY_CONSTRAINT_LABEL=proxy

# Number of proxies in front of the API that append to X-Forwarded-For.
# Express uses this to resolve the real client IP, which keys the login rate
# limiter and is recorded in the audit log.
#
# 2 is correct for this compose file (Traefik → nginx → api). Use 1 if the
# API sits directly behind a single proxy. The value must be exact: too low
# and every client shares one rate-limit bucket; too high and a client can
# spoof its address with its own X-Forwarded-For header.
TRUST_PROXY_HOPS=2

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API. Defaults to
# https://$WEB_HOST,https://$PWA_HOST — set explicitly to add staging origins.
# CORS_ORIGINS=https://museumos.example.org,https://capture.example.org

# ─── First-run admin ──────────────────────────────────────────
# Read by `pnpm db:seed` when creating the initial administrator. If the
# password is omitted, a random one is generated and printed once. Remove
# both after the first successful login.
SEED_ADMIN_EMAIL=admin@example.org
# SEED_ADMIN_PASSWORD=

# ─── Wikidata enrichment (optional) ───────────────────────────
# A contact URL or email, sent in the User-Agent. Wikimedia's policy asks for
# one so they can reach an operator about problem traffic.
# WIKIDATA_CONTACT=https://example.org

# ─── eBay (optional — "Find on eBay" on Book exhibits) ────────
# Register at https://developer.ebay.com/ for an App ID + Cert ID.
# Leave blank to disable the integration.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_GB
EBAY_ENV=production

# ─── Marketing / Meta OAuth (optional) ────────────────────────
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=https://museumos.example.org/api/marketing/oauth/meta/callback
# WEB_BASE_URL=https://museumos.example.org
