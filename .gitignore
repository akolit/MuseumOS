# Generated worksheet from the legacy-image scraper/downloader/attach flow.
# Regenerable; committing it would mean churn on every re-run.
/scripts/legacy-images.csv
/scripts/legacy-images.csv.bak
# File list produced by `psql -A -t -F$'\t' …` so rsync can transfer only
# the freshly-attached storage_keys to prod. Regenerable from the DB.
/scripts/legacy-images-new-files.txt

# Production donor data: real PII (source-organisation names, file metadata).
# Generated by the import-donor-files / container back-fill flow and kept
# locally as a migration record — must never be committed (repo goes public).
/scripts/donor-containers.csv
/scripts/donor-files-prod.sql

